{
  "name": "dependabot-alert-triage",
  "version": "0.1.0",
  "private": true,
  "description": "GitHub Action that dismisses Dependabot alerts matching rules defined in your repository",
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src",
    "fmt": "oxfmt src",
    "fmt:check": "oxfmt --check src",
    "build": "esbuild src/main.ts --bundle --platform=node --target=node24 --outfile=dist/index.js"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "picomatch": "^4.0.2",
    "yaml": "^2.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/picomatch": "^4.0.0",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
